          "type": "testimonial",
          "settings": {
            "star_rating": 5,
            "enable_border": false,
            "heading": "",
            "text_size": 125,
            "text": "<p>\"The quality of apparel and custom reins inside this subscription is remarkable. I look forward to unboxing this parcel every single month.\"<\/p>",

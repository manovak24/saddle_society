            "star_rating": 5,
            "enable_border": false,
            "heading": "",
            "text_size": 125,
            "text": "<p>\"Saddle Society has changed my equine care routine. The leather balms and high-grade supplements pay for the box alone. Essential gear that lasts.\"<\/p>",

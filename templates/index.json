        "step_VCaRgp": {
          "type": "step",
          "settings": {
            "heading": "Unbox the West",
            "text": "<p>Receive a premium monthly collection of trusted apparel, tack, horse care products, and Western lifestyle goods delivered to your door.<\/p>"

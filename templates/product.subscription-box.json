      "type": "how-it-works",
      "blocks": {
        "step_Vd4giq": {
          "type": "step",
          "settings": {
            "heading": "Choose Your Box",
            "text": "<p>Select the claim your box and complete checkout. Skip or cancel anytime.<\/p>"
          }
        },
        "step_byKtAm": {
          "type": "step",
          "settings": {
            "heading": "Personalize Your Profile",
            "text": "<p>Tell us your apparel sizes, riding discipline, horse care needs, preferences and horse blanket and boot sizing. so we can better tailor your experience each and every month. <\/p>"
          }
        },
        "step_78q6dQ": {
          "type": "step",
          "settings": {
            "heading": "Unbox the West",
            "text": "<p>Receive a premium monthly collection of trusted apparel, tack, horse care products, and Western lifestyle goods delivered to your door.<\/p>"
          }
        }
      },
      "block_order": [
        "step_Vd4giq",
        "step_byKtAm",
        "step_78q6dQ"
      ],
      "name": "How it works",
      "settings": {
        "content_position": "left",
        "increase_border_radius": true,
        "badge_text": "Steps",
        "heading": "<p>How Saddle Society Works<\/p>",
        "text": "<p>Choose your box, tell us about you and your horse, and receive a premium selection of Western apparel, tack, horse-care products, and lifestyle essentials every month.<\/p>",

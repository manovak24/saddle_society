          "label": "Heading style",
          "id": "type_style",
          "default": "font-heading",
          "options": [
            {"label": "Heading", "value": "font-heading"},
            {"label": "Body", "value": "font-body"},
            {"label": "Subheading", "value": "subheading-text"}
          ]
        },
        {
          "type": "range",
          "id": "text_size",
          "label": "Heading size",
          "default": 100,
          "min": 100,
          "max": 200,
          "step": 5,
          "unit": "%"

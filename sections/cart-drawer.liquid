{% if settings.cart_type == 'drawer' and template.name != 'cart' %}
  {%- render 'stylesheet', name: 'cart-drawer.css', async: true -%}

  {%- render 'cart-drawer', section: section, cart: cart -%}

  {%- if request.design_mode -%}
    <script>
      {
        const getCartDrawer = () => document.querySelector('[data-cart-drawer]');
        const getCartItems = () => document.querySelector('cart-items');

        // Open drawer when section is selected
        document.addEventListener('shopify:section:select', (event) => {
          const cartDrawer = getCartDrawer();
          const cartElement = getCartItems();

          if (!cartDrawer || !cartElement) return;

          // Check if this is our section
          const sectionId = event.detail.sectionId;
          if (sectionId !== '{{ section.id }}') return;

          // Open the drawer
          if (typeof cartElement.openCartDrawer === 'function') {
            cartElement.openCartDrawer();
            // Focus the drawer after opening
            requestAnimationFrame(() => {
              cartDrawer.focus();
              cartDrawer.setAttribute('tabindex', '-1');
            });
          }
        });

        // Close drawer when section is deselected
        document.addEventListener('shopify:section:deselect', (event) => {
          const cartDrawer = getCartDrawer();
          const cartElement = getCartItems();

          if (!cartDrawer || !cartElement) return;

          const sectionId = event.detail.sectionId;
          if (sectionId !== '{{ section.id }}') return;

          if (typeof cartElement.closeCartDrawer === 'function') {
            cartElement.closeCartDrawer();
          }
        });

        // Highlight block when selected and open drawer if closed
        document.addEventListener('shopify:block:select', (event) => {
          const cartDrawer = getCartDrawer();
          const cartElement = getCartItems();
          if (!cartDrawer || !cartElement) return;

          const sectionId = event.detail.sectionId;
          if (sectionId !== '{{ section.id }}') return;

          const blockId = event.detail.blockId;
          if (!blockId) return;

          // Open drawer if it's closed
          const isDrawerOpen = document.body.classList.contains('js-drawer-open-cart');
          if (!isDrawerOpen && typeof cartElement.openCartDrawer === 'function') {
            cartElement.openCartDrawer();
            // Focus the drawer after opening
            requestAnimationFrame(() => {
              cartDrawer.focus();
              cartDrawer.setAttribute('tabindex', '-1');
            });
          }

          // Function to highlight and scroll to block
          const highlightBlock = () => {
            // Remove previous highlights
            cartDrawer.querySelectorAll('[data-block-highlight]').forEach((el) => {
              el.removeAttribute('data-block-highlight');
            });

            // Find the block element by data-block-id attribute
            const blockElement = cartDrawer.querySelector(`[data-block-id="${blockId}"]`);
            if (blockElement) {
              blockElement.setAttribute('data-block-highlight', 'true');
              // Scroll to block if drawer was just opened
              if (!isDrawerOpen) {
                requestAnimationFrame(() => {
                  blockElement.scrollIntoView({behavior: 'smooth', block: 'nearest'});
                });
              }
            }
          };

          // Wait a bit for drawer to render if it was just opened
          if (!isDrawerOpen) {
            setTimeout(highlightBlock, 200);
          } else {
            highlightBlock();
          }
        });

        // Remove highlight when block is deselected
        document.addEventListener('shopify:block:deselect', (event) => {
          const cartDrawer = getCartDrawer();
          if (!cartDrawer) return;

          const sectionId = event.detail.sectionId;
          if (sectionId !== '{{ section.id }}') return;

          const blockId = event.detail.blockId;
          if (blockId) {
            const blockElement = cartDrawer.querySelector(`[data-block-id="${blockId}"]`);
            if (blockElement) {
              blockElement.removeAttribute('data-block-highlight');
            }
          }
        });

        // Update drawer when block or section is updated
        document.addEventListener('shopify:block:update', (event) => {
          const cartDrawer = getCartDrawer();
          const cartElement = getCartItems();

          if (!cartDrawer || !cartElement) return;

          const sectionId = event.detail.sectionId;
          if (sectionId !== '{{ section.id }}') return;

          // Re-render the drawer to show updated content
          if (typeof cartElement.renderCartDrawer === 'function') {
            cartElement.renderCartDrawer(false);
          }
        });

        document.addEventListener('shopify:section:load', (event) => {
          const cartDrawer = getCartDrawer();
          const cartElement = getCartItems();

          if (!cartDrawer || !cartElement) return;

          const sectionId = event.detail.sectionId;
          if (sectionId !== '{{ section.id }}') return;

          // Re-render the drawer when section is loaded/updated
          if (typeof cartElement.renderCartDrawer === 'function') {
            cartElement.renderCartDrawer(false);
          }
        });
      }
    </script>

    {%- style -%}
      [data-block-highlight] {
        outline: 2px solid rgba(var(--color-primary-rgb), 0.5);
        outline-offset: 4px;
      }
    {%- endstyle -%}
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "header",
      "content": "Button settings"

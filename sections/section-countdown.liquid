{%- comment -%} /sections/section-countdown.liquid {%- endcomment -%}

{%- liquid
  assign animations_enabled = settings.animations_enabled
  assign section_width = section.settings.width

  assign layout_style = section.settings.layout_style
  assign text_alignment = section.settings.text_alignment
  assign section_height = section.settings.height
  assign enable_mobile_height = section.settings.enable_mobile_height
  assign mobile_height = section.settings.mobile_height
  assign image_desktop = section.settings.image
  assign image_mobile = section.settings.image_mobile
  assign overlay_type = section.settings.overlay_type

  assign enable_zoom_animation = section.settings.enable_zoom_animation
  assign color_scheme = 'color-' | append: section.settings.color_scheme

  assign text_width = section.settings.text_width

  assign section_id = 'sectionCountdown--' | append: section.id
  assign section_selector_id = '#' | append: section_id
  assign animation_order = 1
  assign animation_anchor = section_selector_id
  assign is_layout_inline = false
  assign is_layout_stacked = false
  assign has_image = false
  assign timer_bg = false
  assign large_digits = false
  assign timer_last = false
  assign modifiers = ''
  assign hover_scale = ''

  case layout_style
    when 'inline'
      assign modifiers = modifiers | append: ' countdown--inline'
      assign is_layout_inline = true
      assign modifiers = modifiers | append: ' countdown--inline-' | append: text_alignment
    when 'stacked'
      assign modifiers = modifiers | append: ' countdown--stacked'
      assign is_layout_stacked = true
  endcase

  case text_width
    when 'narrow'
      assign modifiers = modifiers | append: ' countdown--content-narrow'
    when 'normal'
      assign modifiers = modifiers | append: ' countdown--content-normal'
  endcase

  if image_desktop != blank or image_mobile != blank
    assign has_image = true
  endif

  assign main_heading = 'countdown.heading' | t
  assign timer_block = section.blocks | where: 'type', 'timer'
  if timer_block != empty
    assign has_timer = true
  endif
-%}

{% if enable_zoom_animation %}
  <script src="{{ 'scrollable-parallax.js' | asset_url }}" defer="defer"></script>
{% endif %}

{%- style -%}
  [data-section-id="{{ section.id }}"] {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
    --min-height: {{ section_height }}px;
    --custom-bg: {{ timer_bg }};
  }

  {% if enable_mobile_height and mobile_height != section_height %}
    @media screen and (max-width: 767px) {
      [data-section-id="{{ section.id }}"] { --min-height: {{ mobile_height }}px; }
    }
  {%- endif %}
{%- endstyle -%}

{%- for block in section.blocks -%}
  {%- liquid
    assign aos_order = animation_order | plus: forloop.index0

    if block.type == 'heading'
      unless block.settings.text == blank
        assign main_heading = block.settings.text
      endunless
    endif
  -%}

  {%- if block.type == 'timer' -%}
    {%- comment -%}
      This countdown always targets the merchant-configured day/time,
      recurring every month in Central time, ignoring theme-default
      end_date/end_time/period fields (those were removed from this block's
      schema). Central offset flips automatically for DST: CDT (-05:00) for
      target months March-October, CST (-06:00) for November-February. The
      "Day of month" field is capped at 1-28 so it's valid in every month
      (Feb included) without extra day-count logic.

      Rollover compares the full target moment (day + time) for THIS month
      against right now, via epoch seconds — so if today is the target day
      but the target time already passed, it rolls straight to next month's
      occurrence instead of waiting for the calendar day to change.
    {%- endcomment -%}
    {%- liquid
      assign target_day = block.settings.day_of_month
      assign target_day_padded = target_day | prepend: '00' | slice: -2, 2

      assign time_parts = block.settings.time | strip | split: ':'
      assign hour_12 = time_parts[0] | plus: 0
      assign minute = time_parts[1] | plus: 0
      assign minute_padded = minute | prepend: '00' | slice: -2, 2

      assign period = block.settings.period
      assign hour_24 = hour_12
      if period == 'pm' and hour_12 < 12
        assign hour_24 = hour_12 | plus: 12
      endif
      if period == 'am' and hour_12 == 12
        assign hour_24 = 0
      endif
      assign hour_24_padded = hour_24 | prepend: '00' | slice: -2, 2

      assign current_month = 'now' | date: '%m' | plus: 0
      assign current_year = 'now' | date: '%Y' | plus: 0
      assign current_month_padded = current_month | prepend: '00' | slice: -2, 2

      assign current_offset = '-06:00'
      if current_month >= 3 and current_month <= 10
        assign current_offset = '-05:00'
      endif

      assign candidate_datetime = current_year | append: '-' | append: current_month_padded | append: '-' | append: target_day_padded | append: 'T' | append: hour_24_padded | append: ':' | append: minute_padded | append: ':00' | append: current_offset

      assign now_epoch = 'now' | date: '%s' | plus: 0
      assign candidate_epoch = candidate_datetime | date: '%s' | plus: 0

      assign target_month = current_month
      assign target_year = current_year

      if candidate_epoch <= now_epoch
        assign target_month = current_month | plus: 1
        if target_month > 12
          assign target_month = 1
          assign target_year = current_year | plus: 1
        endif
      endif

      assign central_offset = '-06:00'
      if target_month >= 3 and target_month <= 10
        assign central_offset = '-05:00'
      endif

      assign target_month_padded = target_month | prepend: '00' | slice: -2, 2
    -%}
    {%- capture expiration_date -%}{{ target_year }}-{{ target_month_padded }}-{{ target_day_padded }}T{{ hour_24_padded }}:{{ minute_padded }}:00{{ central_offset }}{%- endcapture -%}
    {%- assign end_message = block.settings.end_message -%}

    {%- capture timer_markup -%}
      {%- liquid
        assign block_bg_opacity = block.settings.bg_opacity
        assign block_bg_color = block.settings.bg_color
      -%}

      {%- liquid
        if is_layout_inline
          assign block_size = section.blocks.size | minus: 1
          assign aos_order = animation_order | plus: block_size
        endif

        render 'countdown-timer', expiration_date: expiration_date, end_message: end_message, leading_zero: true, animation_anchor: animation_anchor, animation_order: aos_order, bg_color: block_bg_color, bg_opacity: block_bg_opacity
      -%}
    {%- endcapture -%}
  {%- endif -%}

  {%- if block.type == 'button' -%}
    {%- liquid
      comment
        theme-check-disable VariableName
      endcomment
      assign button_1_link = block.settings.button_1_link
      assign button_1_text = block.settings.button_1_text
      assign button_2_text = block.settings.button_2_text
    -%}

    {%- capture entire_section_link -%}
      {%- if button_1_link != blank and button_1_text == blank and button_2_text == blank -%}
        {%- assign hover_scale = ' hover-scale' -%}

        <a href="{{ button_1_link }}"
          class="countdown__link"
          {% if has_timer %}
            aria-labelledby="mainHeading--{{ section_id }} countdownLink--{{ section_id }}"
          {% else %}
            aria-labelledby="mainHeading--{{ section_id }}"
          {% endif %}
        ></a>
      {%- endif -%}
    {%- endcapture -%}
  {%- endif -%}
{%- endfor -%}

<section
  id="{{ section_id }}"
  class="countdown{{ modifiers }} section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="countdown"
  {% unless has_image %}
    data-prevent-transparent-header
  {% endunless %}
>
  <div class="{{ section_width }}">
    <span id="mainHeading--{{ section_id }}" class="visually-hidden">
      {{ main_heading }}
    </span>

    {%- if has_timer -%}
      <span id="countdownLink--{{ section_id }}" class="visually-hidden">
        {{ 'countdown.ends' | t }}
        {{ expiration_date | date: '%A, %B %e, %Y at %H:%M %p %Z' }}
      </span>
    {%- endif -%}

    <div class="countdown__inner item--center {{ hover_scale }}">
      {%- if overlay_type == 'opacity' -%}
        <div class="overlay"></div>
      {%- endif -%}

      {%- if entire_section_link != blank -%}
        {{ entire_section_link }}
      {%- endif -%}

      <div class="countdown__image-container">
        {% if enable_zoom_animation %}
          <parallax-element data-parallax-animation="zoom-on-scroll"></parallax-element>
        {% endif %}
        {%- if has_image -%}
          {%- render 'image-fill',
            is_background: true,
            image_desktop: image_desktop,
            image_mobile: image_mobile,
            sizes: '100vw',
            classes: 'countdown__image'
          -%}
        {%- endif -%}
      </div>

      <div class="countdown__text-container">
        <div class="countdown__content">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- liquid
                assign text = block.settings.text
                assign text_size = block.settings.size | times: 0.01
                assign text_size_mobile = text_size
                assign unique = block.id

                if text_size > 1.5
                  assign text_size_mobile = text_size | times: 0.85
                endif
                if text_size > 2
                  assign text_size_mobile = text_size | times: 0.7
                endif
                if text_size > 2.5
                  assign text_size_mobile = text_size | times: 0.55
                endif
              -%}

              {%- case block.type -%}
                {%- when 'timer' -%}
                  {%- liquid
                    assign unit_size = block.settings.unit_size | times: 0.01
                    assign digit_size = block.settings.digit_size | times: 0.01
                    assign digit_size_mobile = digit_size | times: 0.7
                    assign unit_size_mobile = unit_size | times: 0.8

                    if forloop.index == section.blocks.size
                      assign timer_last = true
                    endif
                  -%}

                  {%- if timer_markup != blank -%}
                    {%- style -%}
                      {{ section_selector_id }} .countdown-timer__digit { --adjust-heading: calc(var(--FONT-ADJUST-HEADING) * {{ digit_size_mobile }}); }
                      {{ section_selector_id }} .countdown-timer__unit { --adjust-unit: calc(var(--FONT-ADJUST-SUBHEADING) * {{ unit_size_mobile }}); }
                      @media screen and (min-width: 1024px) {
                        {{ section_selector_id }} .countdown-timer__digit { --adjust-heading: calc(var(--FONT-ADJUST-HEADING) * {{ digit_size }}); }
                        {{ section_selector_id }} .countdown-timer__unit { --adjust-unit: calc(var(--FONT-ADJUST-SUBHEADING) * {{ unit_size }}); }
                      }
                    {%- endstyle -%}

                    {%- if is_layout_stacked -%}
                      <div
                        class="countdown__block countdown__block--timer{% if large_digits %} countdown__block--timer-large{% endif %}"
                        {{ block.shopify_attributes }}
                      >
                        {{ timer_markup }}
                      </div>
                      {% if animations_enabled %}
                        {%- assign animation_order = animation_order | plus: 4 -%}
                      {% endif %}
                    {%- endif -%}
                  {%- endif -%}

                {%- when 'video' -%}
                  {%- liquid
                    assign video_text = block.settings.video_text
                    assign video_link = block.settings.video_link
                  -%}
                  <div class="countdown__block countdown__block--video main-buttons main-buttons--video">
                    <script src="{{ 'video-play.js' | asset_url }}" defer="defer"></script>

                    <video-popup
                      class="main-buttons__item"
                      {% if animations_enabled %}
                        data-aos="hero"
                        data-aos-anchor="{{ animation_anchor }}"
                        data-aos-order="{{ animation_order }}"
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      <a
                        class="countdown__btn video-text-link"
                        href="{{ video_link | default: '#!' }}"
                        {% unless video_link == blank %}
                          data-video-play="{%- render 'photoswipe-video-html', item_link: video_link, unique: unique -%}"
                        {% endunless %}
                        {% if video_text == blank %}
                          aria-label="{{ 'video.play' | t }}"
                        {% endif %}
                      >
                        {%- render 'icon-play' -%}

                        {%- if video_text != blank -%}
                          <span>{{ video_text }}</span>
                        {%- endif -%}
                      </a>
                    </video-popup>
                  </div>

                {%- when 'subheading' -%}
                  {%- liquid
                    assign block_id = 'countdownSubheading--' | append: unique
                    assign block_selector_id = '#' | append: block_id
                  -%}

                  {%- style -%}
                    {{ block_selector_id }} {
                      --adjust-body: calc(var(--FONT-ADJUST-SUBHEADING) * {{ text_size_mobile }});
                    }
                    @media screen and (min-width: 1024px) {
                      {{ block_selector_id }} {
                        --adjust-body: calc(var(--FONT-ADJUST-SUBHEADING) * {{ text_size }});
                      }
                    }
                  {%- endstyle -%}

                  {%- if text != blank -%}
                    <div
                      id="{{ block_id }}"
                      class="countdown__block countdown__block--subheading subheading-text"
                      {% if animations_enabled %}
                        data-aos="hero"
                        data-aos-anchor="{{ animation_anchor }}"
                        data-aos-order="{{ animation_order }}"
                        {%- assign animation_order = animation_order | plus: 1 -%}
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      {{ text }}
                    </div>
                  {%- endif -%}

                {%- when 'heading' -%}
                  {%- liquid
                    assign title = block.settings.text
                    assign heading_highlight_type = block.settings.heading_highlight_type
                    assign highlight_color = block.settings.highlight_color
                    assign highlight_text_color = block.settings.highlight_text_color
                    assign block_id = 'countdownHeading--' | append: unique
                    assign block_selector_id = '#' | append: block_id

                    capture highlight_data
                      render 'setup-text-highlight', title: title, heading_highlight_type: heading_highlight_type, highlight_color: highlight_color
                    endcapture

                    assign highlight_parts = highlight_data | split: '|||'
                    assign has_text_highlight = highlight_parts[0]
                    assign text_highlight_wrapper_class = highlight_parts[1]
                    assign title = highlight_parts[2]
                  -%}

                  {%- style -%}
                    {{ block_selector_id }} {
                      --adjust-heading: calc(var(--FONT-ADJUST-HEADING) * {{ text_size_mobile }});

                      {%- if heading_highlight_type != 'highlight' %}
                        --highlight-color: var(--text);
                      {%- endif -%}

                      {%- if highlight_color != 'rgba(0,0,0,0)' and highlight_color != '' %}
                        --highlight-color: {{ highlight_color }};
                      {%- endif -%}

                      {%- if highlight_text_color != 'rgba(0,0,0,0)' and highlight_text_color != '' %}
                        --highlight-text-color: {{ highlight_text_color }};
                      {%- endif %}
                    }
                    @media screen and (min-width: 1024px) {
                      {{ block_selector_id }} {
                        --adjust-heading: calc(var(--FONT-ADJUST-HEADING) * {{ text_size }});
                      }
                    }
                  {%- endstyle -%}

                  {%- if title != blank -%}
                    {%- capture title_attributes -%}
                      id="{{ block_id }}" class="countdown__block countdown__block--heading h2{% if has_text_highlight == 'true' %} {{ text_highlight_wrapper_class }}{% endif %}"
                      {% if animations_enabled %}
                        data-aos="hero"
                        data-aos-anchor="{{ animation_anchor }}"
                        data-aos-order="{{ animation_order }}"
                        {%- assign animation_order = animation_order | plus: 1 -%}
                      {% endif %}
                      {{ block.shopify_attributes }}
                    {%- endcapture -%}

                    {% render 'title-text-reveal-and-highlights',
                      title: title,
                      title_attributes: title_attributes,
                      has_text_highlight: has_text_highlight
                    %}

                    {%- if settings.show_spacer_lines and forloop.last == false -%}
                      <hr
                        {% if animations_enabled %}
                          data-aos="hero"
                          data-aos-order="{{ animation_order }}"
                          data-aos-anchor="{{ animation_anchor }}"
                          {%- assign animation_order = animation_order | plus: 1 -%}
                        {% endif %}
                      >
                    {%- endif -%}
                  {%- endif -%}

                {%- when 'text' -%}
                  {%- liquid
                    assign block_id = 'countdownText--' | append: unique
                    assign block_selector_id = '#' | append: block_id
                  -%}

                  {%- style -%}
                    {{ block_selector_id }} {
                      --adjust-body: calc(var(--FONT-ADJUST-BODY) * {{ text_size_mobile }});
                    }
                    @media screen and (min-width: 1024px) {
                      {{ block_selector_id }} {
                        --adjust-body: calc(var(--FONT-ADJUST-BODY) * {{ text_size }});
                      }
                    }
                  {%- endstyle -%}

                  {%- if text != blank -%}
                    <div
                      id="{{ block_id }}"
                      class="countdown__block countdown__block--text"
                      {% if animations_enabled %}
                        data-aos="hero"
                        data-aos-anchor="{{ animation_anchor }}"
                        data-aos-order="{{ animation_order }}"
                        {%- assign animation_order = animation_order | plus: 1 -%}
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      {{ text }}
                    </div>
                  {%- endif -%}

                {%- when 'button' -%}
                  {%- liquid
                    assign block_id = 'countdownButton--' | append: unique
                    assign button_1_link = block.settings.button_1_link
                    assign button_1_text = block.settings.button_1_text
                    assign button_1_style = block.settings.button_1_style
                    assign button_1_color = block.settings.button_1_color
                    assign button_1_size = block.settings.button_1_size

                    assign button_2_link = block.settings.button_2_link
                    assign button_2_text = block.settings.button_2_text
                    assign button_2_style = block.settings.button_2_style
                    assign button_2_color = block.settings.button_2_color
                    assign button_2_size = block.settings.button_2_size

                    assign button_1_advanced_class = 'btn--advanced'
                    if button_1_style != 'btn--text'
                      assign button_1_advanced_class = button_1_advanced_class | append: ' btn--advanced-width-height'
                    endif
                    assign button_2_advanced_class = 'btn--advanced'
                    if button_2_style != 'btn--text'
                      assign button_2_advanced_class = button_2_advanced_class | append: ' btn--advanced-width-height'
                    endif
                  -%}

                  {%- if button_1_text != blank or button_2_text != blank -%}
                    <div class="countdown__block countdown__block--button main-buttons">
                      {%- if button_1_text != blank -%}
                        <div
                          class="main-buttons__item"
                          {% if animations_enabled %}
                            data-aos="hero"
                            data-aos-anchor="{{ animation_anchor }}"
                            data-aos-order="{{ animation_order }}"
                            {%- assign animation_order = animation_order | plus: 1 -%}
                          {% endif %}
                        >
                          <a
                            href="{{ button_1_link }}"
                            class="countdown__btn btn {{ button_1_style }} {{ button_1_size }} {{ button_1_color }} {{ button_1_advanced_class }}"
                            {% if has_timer %}
                              aria-labelledby="countdownButton1Text--{{ block_id }} countdownLink--{{ section_id }}"
                            {% else %}
                              aria-labelledby="countdownButton1Text--{{ block_id }}"
                            {% endif %}
                          >
                            <hover-button></hover-button>
                            {{- button_1_text | escape -}}
                          </a>

                          <span
                            id="countdownButton1Text--{{ block_id }}"
                            class="visually-hidden"
                          >
                            {{- button_1_text | escape }}.
                          </span>
                        </div>
                      {%- endif -%}

                      {%- if button_2_text != blank -%}
                        <div
                          class="main-buttons__item"
                          {% if animations_enabled %}
                            data-aos="hero"
                            data-aos-anchor="{{ animation_anchor }}"
                            data-aos-order="{{ animation_order }}"
                            {%- assign animation_order = animation_order | plus: 1 -%}
                          {% endif %}
                        >
                          <a
                            href="{{ button_2_link }}"
                            class="countdown__btn btn {{ button_2_style }} {{ button_2_size }} {{ button_2_color }} {{ button_2_advanced_class }}"
                            {% if has_timer %}
                              aria-labelledby="countdownButton2Text--{{ block_id }} countdownLink--{{ section_id }}"
                            {% else %}
                              aria-labelledby="countdownButton2Text--{{ block_id }}"
                            {% endif %}
                          >
                            <hover-button></hover-button>
                            {{- button_2_text | escape -}}
                          </a>

                          <span
                            id="countdownButton2Text--{{ block_id }}"
                            class="visually-hidden"
                          >
                            {{- button_2_text | escape }}.
                          </span>
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          {%- else -%}
            {%- render 'no-blocks' -%}
          {%- endif -%}
        </div>

        {%- if timer_markup != blank and is_layout_inline -%}
          <div class="countdown__aside{% if large_digits %} countdown__aside--timer-large{% endif %}{% if timer_last %} countdown__aside--timer-last{% endif %}">
            {{ timer_markup }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Countdown",
  "class": "supports-transparent-header",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Style",
      "default": "inline",
      "options": [
        {"label": "Inline", "value": "inline"},
        {"label": "Stacked", "value": "stacked"}
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "visible_if": "{{ section.settings.layout_style == 'inline' }}",
      "label": "Mobile text alignment",
      "default": "center",
      "options": [
        {"label": "Left", "value": "left"},
        {"label": "Center", "value": "center"}
      ]
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "150",
      "options": [
        {"label": "450px", "value": "450"},
        {"label": "400px", "value": "400"},
        {"label": "350px", "value": "350"},
        {"label": "300px", "value": "300"},
        {"label": "250px", "value": "250"},
        {"label": "200px", "value": "200"},
        {"label": "150px", "value": "150"}
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_height",
      "label": "Enable mobile height",
      "default": false
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile height",
      "default": "400",
      "options": [
        {"label": "450px", "value": "450"},
        {"label": "400px", "value": "400"},
        {"label": "350px", "value": "350"},
        {"label": "300px", "value": "300"},
        {"label": "250px", "value": "250"},
        {"label": "200px", "value": "200"},
        {"label": "150px", "value": "150"}
      ]
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "2048px width recommended"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional"
    },
    {
      "type": "select",
      "id": "overlay_type",
      "label": "Overlay type",
      "default": "disabled",
      "options": [
        {"value": "disabled", "label": "Disabled"},
        {"value": "opacity", "label": "Opacity overlay"}
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_zoom_animation",
      "label": "Enable zoom animation on scroll",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "select",
      "id": "text_width",
      "label": "Width",
      "default": "normal",
      "options": [
        {"label": "Narrow", "value": "narrow"},
        {"label": "Normal", "value": "normal"}
      ]
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper--full-padded",
      "options": [
        {"value": "wrapper--full", "label": "Full width"},
        {"value": "wrapper--full-padded", "label": "Full width padded"},
        {"value": "wrapper", "label": "Page width"}
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,

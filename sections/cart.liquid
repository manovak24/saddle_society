<!-- /templates/cart.liquid -->
{%- liquid
  assign subtotal = cart.total_price | plus: 0
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign selected_color_scheme = section.settings.color_scheme | strip
  assign scheme_bg_color = settings.color_schemes[selected_color_scheme].settings.section_bg
  assign animations_enabled = settings.animations_enabled
  assign animation_delay = 0
  assign cart_items_size = cart.item_count | plus: 0
  assign out_of_stock_product_title = ''
  assign continue_shopping_translated = 'cart.general.continue_shopping' | t
  assign continue_shopping_text = settings.empty_cart_button_text | default: continue_shopping_translated
  assign continue_shopping_link = settings.empty_cart_button_link | default: routes.all_products_collection_url
  assign enable_accept_terms = settings.enable_accept_terms
  assign has_progress_holder = true
  assign section_id = 'cart--' | append: section.id
  assign section_selector = section_id | prepend: '#'
  assign aos_anchor = section_selector
  assign cart_button_style = section.settings.cart_button_style
  assign cart_button_size = section.settings.cart_button_size
  assign cart_button_color = section.settings.cart_button_color

  assign content_block_ids = ''
  assign aside_block_ids = ''
  assign shipping_estimate_block = section.blocks | where: 'type', 'shipping-estimate'

  for block in section.blocks
    if block.type == 'title' or block.type == 'products'
      assign content_block_ids = content_block_ids | append: block.id | append: ','
    else
      assign aside_block_ids = aside_block_ids | append: block.id | append: ','
    endif
  endfor

  assign content_block_ids = content_block_ids | split: ','
  assign aside_block_ids = aside_block_ids | split: ','

  capture cart_items
    render 'cart-line-items', part: 'line-items', aos_anchor: '#cartItemsHolder'
  endcapture
-%}

{%- render 'stylesheet', name: 'template-cart.css' -%}

{%- if shipping_estimate_block.size > 0 -%}
  <script src="{{ 'shipping-calculator.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .cart {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- if cart_items contains 'data-out-of-stock-title' -%}
  {%- assign out_of_stock_product_title = cart_items
    | split: '<p class="hidden" data-out-of-stock-title>'
    | last
    | split: '</p>'
    | first
    | strip
  -%}

  <script>
    window.theme.outOfStockProductTitle = {{ out_of_stock_product_title | json }};
  </script>
{%- endif -%}

<section
  id="{{ section_id }}"
  class="cart section-padding {{ color_scheme }}{% if settings.quantity_style == 'dropdown' %} cart--no-overflow{% endif %}"
  data-section-type="cart-template"
  data-section-id="{{ section.id }}"
  data-cart-page
  {% if animations_enabled %}
    data-aos-intersection="0"
    data-aos-watch-anchors
  {% endif %}
>
  <cart-items data-cart-page>
    <div class="wrapper">
      <form action="{{ routes.cart_url }}" method="post" novalidate data-cart-form>
        <div class="cart__empty{% if cart_items_size > 0 %} hidden{% endif %}" data-empty-message>
          {%- render 'cart-empty',
            aos_anchor: aos_anchor,
            bg_color: scheme_bg_color,
            cart_button_style: cart_button_style,
            cart_button_color: cart_button_color,
            cart_button_size: cart_button_size
          -%}
        </div>

        {{ form.errors | default_errors }}

        <div class="cart__inner">
          <div
            class="cart__content"
            {% if animations_enabled %}
              data-aos="fade"
              data-aos-anchor="{{ aos_anchor }}"
              {%- assign animation_delay = 50 -%}
              data-aos-delay="{{ animation_delay }}"
              {%- assign animation_delay = animation_delay | plus: 100 -%}
            {% endif %}
          >
            {%- for block_id in content_block_ids -%}
              {%- assign block = section.blocks | find: 'id', block_id -%}
              {%- case block.type -%}
                {%- when 'title' -%}
                  {%- liquid
                    assign cart_title_default = 'cart.general.title' | t
                    assign cart_title_text = block.settings.title_text | default: cart_title_default
                    assign type_style = block.settings.type_style
                    assign text_size = block.settings.text_size | times: 0.01
                  -%}

                  {%- capture title_style -%}
                    {%- render 'heading-style', type_style: type_style, size: text_size -%}
                  {%- endcapture -%}

                  <h1
                    class="cart__title {{ type_style }}"
                    {{ title_style }}
                    {{ block.shopify_attributes }}
                  >
                    {{ cart_title_text -}}
                    <span class="cart__item-qty" data-cart-items-qty>
                      {{- 'cart.label.items_with_count' | t: count: cart_items_size -}}
                    </span>
                  </h1>
                  <a
                    href="{{ continue_shopping_link }}"
                    class="btn btn--secondary btn--solid btn--advanced btn--advanced-width-height"
                  >
                    <hover-button></hover-button>
                    {{- continue_shopping_text -}}
                  </a>
                {%- when 'products' -%}
                  <div class="cart__errors" role="alert" data-cart-errors>
                    <div class="cart__errors__inner">
                      <p class="cart__errors__heading">{{- 'cart.general.limit_error' | t -}}</p>

                      <p class="cart__errors__content" data-error-message></p>

                      <button
                        type="button"
                        class="cart__errors__close"
                        data-cart-error-close
                        aria-label="{{ 'general.accessibility.dismiss' | t }} {{ 'cart.general.title' | t }}"
                      >
                        {%- render 'icon-close' -%}
                      </button>
                    </div>
                  </div>

                  <div
                    class="cart__items__wrapper"
                    data-items-wrapper
                    {{ block.shopify_attributes }}
                  >
                    <div class="loader loader--line"><div class="loader-indeterminate"></div></div>

                    <div id="cartItemsHolder" class="cart__items" data-items-holder>
                      {{ cart_items }}
                    </div>
                  </div>

                  <button
                    type="submit"
                    name="update"
                    class="cart__update btn btn--secondary btn--advanced btn--advanced-width-height"
                  >
                    <hover-button></hover-button>
                    {{- 'cart.general.update' | t -}}
                  </button>
              {%- endcase -%}
            {%- endfor -%}
          </div>

          <div
            class="cart__aside{% if cart_items_size <= 0 %} hidden{% endif %}"
            data-foot-holder
            {% if animations_enabled %}
              data-aos="fade-up"
              data-aos-anchor="{{ aos_anchor }}"
              {%- assign animation_delay = animation_delay | plus: 100 -%}
              data-aos-delay="{{ animation_delay }}"
              {%- assign animation_delay = 0 -%}
            {% endif %}
          >
            {%- for block_id in aside_block_ids -%}
              {%- assign block = section.blocks | find: 'id', block_id -%}
              {%- liquid
                assign block_class = 'cart__block'
                if block.settings.show_border_bottom
                  assign block_class = block_class | append: ' has-border-bottom'
                endif
              -%}
              {%- case block.type -%}
                {%- when 'cart-message' -%}
                  {%- if block.settings.cart_custom_message_text != blank -%}
                    <div
                      class="{{ block_class }} cart-message cart-message--custom"
                      data-cart-bar
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.cart_custom_message_text }}
                    </div>
                  {%- endif -%}
                {%- when 'free-shipping-message' -%}
                  <div
                    class="{{ block_class }} cart__block--shipping-message"
                    {{ block.shopify_attributes }}
                  >
                    {%- render 'cart-message',
                      aos_anchor: aos_anchor,
                      animation_delay: animation_delay,
                      has_progress_holder: has_progress_holder,
                      block: block
                    -%}
                  </div>
                {%- when 'upsell' -%}
                  <div class="{{ block_class }} cart__block--upsell" {{ block.shopify_attributes }}>
                    <div
                      id="cartUpsellHolder"
                      class="cart__pair"
                      data-pair-products-holder
                    >
                      {%- render 'cart-line-items', part: 'upsell-items', aos_anchor: '#cartUpsellHolder' -%}
                    </div>
                  </div>
                {%- when 'discount-code' -%}
                  <collapsible-elements
                    class="{{ block_class }} cart__block--widget"
                    data-collapsible-single
                    data-collapsible-group="cart-widgets"
                    {{ block.shopify_attributes }}
                  >
                    {%- render 'discount' -%}
                  </collapsible-elements>
                {%- when 'order-note' -%}
                  <collapsible-elements
                    class="{{ block_class }} cart__block--widget"
                    data-collapsible-single
                    data-collapsible-group="cart-widgets"
                    {{ block.shopify_attributes }}
                  >
                    <div class="cart-widget">
                      <button
                        class="cart-widget__title"
                        type="button"
                        data-collapsible-trigger
                        aria-expanded="false"
                        aria-controls="notes"
                      >
                        {{- 'cart.general.cart_notes_label' | t -}}
                        {%- render 'icon-toggle-plus' -%}
                        {%- render 'icon-toggle-minus' -%}
                      </button>

                      <div id="notes" data-collapsible-container>
                        <div class="cart-widget__content" data-collapsible-content>
                          <label for="note">{{ 'cart.general.customer_note' | t }}</label>

                          <textarea
                            id="note"
                            name="note"
                            class="cart__field cart__field--textarea"
                            aria-label="{{ 'cart.general.customer_note' | t }}"
                          >{{- cart.note -}}</textarea>
                        </div>
                      </div>
                    </div>
                  </collapsible-elements>
                {%- when 'gift-note' -%}
                  <collapsible-elements
                    class="{{ block_class }} cart__block--widget"
                    data-collapsible-single
                    data-collapsible-group="cart-widgets"
                    {{ block.shopify_attributes }}
                  >
                    <div class="cart-widget">
                      <button
                        class="cart-widget__title"
                        type="button"
                        data-collapsible-trigger
                        aria-expanded="false"
                        aria-controls="gift-notes"
                      >
                        {{- 'cart.general.gift_notes_label' | t -}}
                        {%- render 'icon-toggle-plus' -%}
                        {%- render 'icon-toggle-minus' -%}
                      </button>

                      <div id="gift-notes" data-collapsible-container>
                        <div class="cart-widget__content" data-collapsible-content>
                          {%- liquid
                            assign gift_note_attribute_default = 'Gift note'
                            assign gift_note_attribute_string = 'cart.general.gift_note_attribute' | t
                            assign gift_note_attribute = gift_note_attribute_string | default: gift_note_attribute_default
                          -%}

                          <label for="gift-note">{{ 'cart.general.note' | t }}</label>

                          <textarea
                            id="gift-note"
                            name="attributes[{{ gift_note_attribute }}]"
                            class="cart__field cart__field--textarea"
                            aria-label="{{ 'cart.general.note' | t }}"
                          >{{ cart.attributes[gift_note_attribute] }}</textarea>
                        </div>
                      </div>
                    </div>
                  </collapsible-elements>
                {%- when 'checkout-buttons' -%}
                  {%- liquid
                    assign has_dynamic_checkout_buttons = false
                    if block.settings.enable_additional_buttons and additional_checkout_buttons
                      assign has_dynamic_checkout_buttons = true
                    endif
                  -%}
                  <div
                    class="cart__foot-inner"
                    {{ block.shopify_attributes }}
                  >
                    <div class="cart__buttons-wrapper">
                      {%- if enable_accept_terms -%}
                        <input type="hidden" name="attributes[{{ 'cart.general.accepted_terms' | t }}]" value="Yes">
                        <input
                          type="checkbox"
                          class="cart__acceptance__input"
                          name="acceptance"
                          id="acceptance"
                          data-cart-acceptance-checkbox
                        >
                        <label for="acceptance" class="cart__acceptance__label" data-cart-acceptance-label>
                          {{- settings.accept_terms_text -}}
                        </label>
                      {%- endif -%}

                      <p class="cart__terms cart__errors__content" data-terms-error-message></p>

                      <div
                        class="cart__buttons{% if enable_accept_terms %} cart__buttons--disabled{% endif %}"
                        data-cart-checkout-buttons
                      >
                        <fieldset class="cart__buttons__fieldset" data-cart-checkout-button>
                          <button
                            type="submit"
                            name="checkout"
                            class="btn {{ cart_button_style }} {{ cart_button_color }} {{ cart_button_size }} btn--advanced btn--advanced-width-height btn--advanced-adaptive-width cart__checkout{% if has_dynamic_checkout_buttons %} cart__checkout--dynamic{% endif %}"
                          >
                            <hover-button></hover-button>
                            {{- 'cart.general.checkout' | t -}}
                          </button>

                          {%- if has_dynamic_checkout_buttons -%}
                            <div
                              class="additional-checkout-buttons additional-checkout-buttons--vertical"
                              data-additional-checkout-button
                            >
                              {{- content_for_additional_checkout_buttons -}}
                            </div>
                          {%- endif -%}
                        </fieldset>
                      </div>
                    </div>

                    <p class="cart__text">{{- 'cart.general.shipping_at_checkout' | t -}}</p>
                  </div>
                {%- when 'payment-icons' -%}
                  {%- liquid
                    assign enable_greyscale = block.settings.enable_greyscale
                    assign icon_alignment = block.settings.icon_alignment
                  -%}

                  <div
                    class="{{ block_class }} cart__block--payment-icons {{ icon_alignment }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- render 'footer-payment', enable_greyscale: enable_greyscale -%}
                  </div>
                {%- when 'shipping-estimate' -%}
                  <collapsible-elements
                    class="{{ block_class }} cart__block--widget"
                    data-collapsible-single
                    data-collapsible-group="cart-widgets"
                    {{ block.shopify_attributes }}
                  >
                    {%- render 'cart-block-shipping-calculator',
                      cart_button_style: cart_button_style,
                      cart_button_color: cart_button_color,
                      cart_button_size: cart_button_size
                    -%}
                  </collapsible-elements>
                {%- when 'subtotal' -%}
                  <div data-cart-price-holder>{%- render 'cart-price' -%}</div>

                  <div
                    class="{{ block_class }} cart__total"
                    {{ block.shopify_attributes }}
                  >
                    <span>{{ 'cart.general.subtotal' | t }}</span>

                    <span class="cart__total__money" data-cart-total-price>
                      {%- liquid
                        if subtotal == 0
                          echo 'products.product.free' | t
                        else
                          echo subtotal | money_with_currency
                        endif
                      -%}
                    </span>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </form>
    </div>
  </cart-items>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Button settings"
    },
    {
      "type": "select",
      "id": "cart_button_color",
      "label": "Button color",
      "default": "btn--primary",
      "options": [
        {"label": "Primary", "value": "btn--primary"},
        {"label": "Secondary", "value": "btn--secondary"},
        {"label": "White", "value": "btn--white"},
        {"label": "Black", "value": "btn--black"}
      ]
    },
    {
      "type": "select",
      "id": "cart_button_style",
      "label": "Button style",
      "default": "btn--solid-border",
      "options": [
        {"label": "Solid", "value": "btn--solid"},
        {"label": "Outline", "value": "btn--outline"},
        {"label": "Solid with border", "value": "btn--solid-border"},
        {"label": "Soft", "value": "btn--soft"},
        {"label": "Text", "value": "btn--text"}
      ]
    },
    {
      "type": "select",
      "id": "cart_button_size",
      "label": "Size",
      "default": "btn--medium",
      "options": [
        {"label": "Small", "value": "btn--small"},
        {"label": "Medium", "value": "btn--medium"},
        {"label": "Large", "value": "btn--large"}
      ]
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title_text",
          "label": "Title",
          "default": "Cart"
        },
        {
          "type": "select",
          "label": "Heading style",
          "id": "type_style",
          "default": "font-heading",
          "options": [
            {"label": "Heading", "value": "font-heading"},
            {"label": "Body", "value": "font-body"},
            {"label": "Subheading", "value": "subheading-text"}
          ]
        },
        {
          "type": "range",
          "id": "text_size",
          "label": "Heading size",
          "default": 100,
          "min": 100,
          "max": 200,
          "step": 5,
          "unit": "%"
        }
      ]
    },
    {
      "type": "cart-message",
      "name": "Cart message",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "cart_custom_message_text",
          "label": "Text",
          "default": "<p>New customers save 10% with code <strong>WELCOME10<\/strong><\/p>"
        },
        {
          "type": "checkbox",
          "id": "show_border_bottom",
          "label": "Show bottom border",
          "default": false
        }
      ]
    },
    {
      "type": "free-shipping-message",
      "name": "Free shipping message",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "message",
          "label": "Message",
          "info": "Use ||amount|| to display progress towards free shipping.",
          "default": "Spend ||amount|| more for FREE shipping."
        },
        {
          "type": "checkbox",
          "id": "show_border_bottom",
          "label": "Show bottom border",
          "default": false
        }
      ]
    },
    {
      "type": "products",
      "name": "Products",
      "limit": 1,
      "settings": []
    },
    {
      "type": "upsell",
      "name": "Upsell",
      "limit": 1,
      "settings": []
    },
    {
      "type": "discount-code",
      "name": "Discount code",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_border_bottom",
          "label": "Show bottom border",
          "default": false
        }
      ]
    },
    {
      "type": "order-note",
      "name": "Order note",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_border_bottom",
          "label": "Show bottom border",
          "default": false
        }
      ]
    },
    {
      "type": "gift-note",
      "name": "Gift note",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_border_bottom",
          "label": "Show bottom border",
          "default": false
        }
      ]
    },
    {
      "type": "checkout-buttons",
      "name": "Checkout buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "enable_additional_buttons",
          "label": "Enable additional checkout buttons",
          "default": false
        }
      ]
    },
    {
      "type": "payment-icons",
      "name": "Payment icons",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "icon_alignment",
          "label": "Icon alignment",
          "default": "text-left",
          "options": [
            {
              "value": "text-left",
              "label": "Left"
            },
            {
              "value": "text-center",
              "label": "Center"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "enable_greyscale",
          "label": "Enable greyscale for payment icons",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_border_bottom",
          "label": "Show bottom border",
          "default": false
        }
      ]
    },
    {
      "type": "shipping-estimate",
      "name": "Shipping estimate",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_border_bottom",
          "label": "Show bottom border",
          "default": false
        }
      ]
    },
    {
      "type": "subtotal",
      "name": "Subtotal",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_border_bottom",
          "label": "Show bottom border",
          "default": false
        }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}

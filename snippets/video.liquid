{%- comment -%}
  Renders a video section with text overlay

  Accepts:
  - animation_anchor: {String} Hook for the AOS animation (required)
  - button_1_color: {String} Primary button color class (required)
  - button_1_link: {String} Primary button URL (required)
  - button_1_size: {String} Primary button size class (required)
  - button_1_style: {String} Primary button style class (required)
  - button_1_text: {String} Primary button label (required)
  - button_2_color: {String} Secondary button color class (required)
  - button_2_link: {String} Secondary button URL (required)
  - button_2_size: {String} Secondary button size class (required)
  - button_2_style: {String} Secondary button style class (required)
  - button_2_text: {String} Secondary button label (required)
  - button_color: {String} Button color class (required)
  - button_link: {String} Button URL (required)
  - button_size: {String} Button size class (required)
  - button_style: {String} Button style class (required)
  - button_text: {String} Button label (required)
  - has_text_highlight: {Boolean} Enable heading text highlight (required)
  - heading_size: {String} Heading size class (required)
  - opacity_overlay: {Number} Video overlay opacity (required)
  - show_text_background: {Boolean} Show text background behind content (required)
  - text: {String} Body text content (required)
  - text_highlight_wrapper_class: {String} Text highlight wrapper class (required)
  - text_underlay: {Boolean} Enable text underlay (required)
  - title: {String} Title text (required)
  - unique: {String} Unique id prefix for elements (required)
  - video_link: {Object} Video link object (required)

  Usage:
  {% render 'video' %}
{%- endcomment -%}
<!-- /snippets/video.liquid -->
{%- liquid
  assign animations_enabled = settings.animations_enabled
  assign title_highlights = title_highlights | default: false
  assign video_size = video_size | default: 'video-cover'
  assign sizes = image_sizes | default: '100vw'
  assign text_width = text_width | default: 'narrow'
  capture image_classes
    echo 'video-background video-background--image'
    if image == blank
      echo ' placeholder-bg'
    endif
  endcapture

  assign button_advanced_class = 'btn--advanced'
  if button_style != 'btn--text'
    assign button_advanced_class = button_advanced_class | append: ' btn--advanced-width-height'
  endif

  assign button_1_advanced_class = 'btn--advanced'
  if button_1_style != 'btn--text'
    assign button_1_advanced_class = button_1_advanced_class | append: ' btn--advanced-width-height'
  endif

  assign button_2_advanced_class = 'btn--advanced'
  if button_2_style != 'btn--text'
    assign button_2_advanced_class = button_2_advanced_class | append: ' btn--advanced-width-height'
  endif

  case text_width
    when 'narrow'
      assign text_width_class = 'wrapper--narrow'
    when 'normal'
      assign text_width_class = 'wrapper--normal'
    when 'wide'
      assign text_width_class = 'wrapper--wide'
  endcase

  case text_position
    when 'top-left'
      assign text_position_class = 'align--top-left'
    when 'top-center'
      assign text_position_class = 'align--top-center'
    when 'top-right'
      assign text_position_class = 'align--top-right'
    when 'middle-center'
      assign text_position_class = 'align--middle-center'
    when 'bottom-left'
      assign text_position_class = 'align--bottom-left'
    when 'bottom-center'
      assign text_position_class = 'align--bottom-center'
    when 'bottom-right'
      assign text_position_class = 'align--bottom-right'
  endcase
-%}

{%- capture image_attributes -%}
  {%- if animations_enabled -%}
    data-aos="fade"
    data-aos-anchor="{{ animation_anchor }}"
    data-aos-delay="{{ animation_delay }}"
  {%- endif -%}
{%- endcapture -%}

<div
  class="video__container video__container--{{ unique }}{% unless image %} img-in{% endunless %}"
  id="video-{{ unique }}-container"
>
  {%- if background_video == blank -%}
    {%- render 'image-fill',
      is_background: true,
      img_object: image,
      image_attributes: image_attributes,
      sizes: sizes,
      classes: image_classes,
      placeholder_svg: 'lifestyle-1'
    -%}
  {%- endif -%}

  {%- assign video_bg_show = false -%}
  {%- if background_video != blank -%}
    {%- assign video_link_bg_downcase = background_video | downcase -%}

    {%- if video_link_bg_downcase contains '.mp4' -%}
      {%- assign video_bg_show = true -%}
    {%- endif -%}
  {%- endif -%}

  {%- if video_bg_show -%}
    <div class="video-background">
      <div
        class="video__player is-loading"
        data-video-player
        data-video-id="{{ unique }}-video-background"
      >
        <template data-video-template>
          <video
            id="{{ unique }}-video-background"
            class="{{ video_size }}"
            data-video-type="native"
            data-video-autoplay
            playsinline
            autoplay
            loop
            muted
            width="320"
            height="240"
          >
            <source src="{{ background_video }}" type="video/mp4">
          </video>
        </template>
      </div>
    </div>
  {%- endif -%}

  {%- if video_size == 'video-cover' and opacity_overlay -%}
    <div class="overlay video__overlay"></div>
  {%- endif -%}
</div>

<div class="text-inside {{ text_position_class }}">
  {%- if video_size == 'video-fit' and opacity_overlay -%}
    <div class="overlay video__overlay"></div>
  {%- endif -%}

  {% comment %} Text {% endcomment %}
  <div class="video-text-wrapper {{ text_width_class }}{% if text_underlay %} backdrop--radial{% endif %}{% if show_text_background %} text-background{% endif %}">
    {%- if video_link != blank -%}
      {% comment %} Video Play Button {% endcomment %}
      <script src="{{ 'video-play.js' | asset_url }}" defer="defer"></script>

      <div class="main-buttons main-buttons--video {{ text_position_class }}">
        <video-popup
          class="main-buttons__item"
          {% if animations_enabled %}
            data-aos="fade-up"
            data-aos-anchor="{{ animation_anchor }}"
            data-aos-delay="{{ animation_delay }}"
            {%- assign animation_delay = animation_delay | plus: 150 -%}
          {% endif %}
        >
          <a
            href="{{ video_link }}"
            class="video-text-link"
            data-video-play="{% render 'photoswipe-video-html', item_link: video_link, unique: unique %}"
            aria-label="{{ 'video.play' | t }}"
          >
            {%- render 'icon-play' -%}
          </a>
        </video-popup>
      </div>
    {%- endif -%}

    {%- if title != blank -%}
      {%- capture title_attributes -%}
        class="h1 main-heading{% if has_text_highlight == 'true' %} {{ text_highlight_wrapper_class }}{% endif %}"
        {% if animations_enabled %}
          data-aos="fade-up"
          data-aos-anchor="{{ animation_anchor }}"
          data-aos-delay="{{ animation_delay }}"
          {%- assign animation_delay = animation_delay | plus: 150 -%}
        {% endif %}
        style="font-size: calc({{ heading_size }} * 3rem * var(--FONT-ADJUST-HEADING))"
      {%- endcapture -%}

      {%- if title_highlights -%}
        {% render 'title-text-reveal-and-highlights',
          title: title,
          title_attributes: title_attributes,
          has_text_highlight: has_text_highlight
        %}
      {%- else -%}
        <div {{ title_attributes }}>{{- title -}}</div>
      {%- endif -%}
    {%- endif -%}

    {%- if text != blank -%}
      <div
        class="main-text h2"
        {% if animations_enabled %}
          data-aos="fade-up"
          data-aos-anchor="{{ animation_anchor }}"
          data-aos-delay="{{ animation_delay }}"
          {%- assign animation_delay = animation_delay | plus: 150 -%}
        {% endif %}
      >
        {{- text -}}
      </div>
    {%- endif -%}

    {% comment %} Buttons {% endcomment %}
    {%- if button_text != blank -%}
      <div class="main-buttons {{ text_position_class }}">
        <div
          class="main-buttons__item"
          {% if animations_enabled %}
            data-aos="fade-up"
            data-aos-anchor="{{ animation_anchor }}"
            data-aos-delay="{{ animation_delay }}"
          {% endif %}
        >
          <a
            class="btn {{ button_style }} {{ button_size }} {{ button_color }} {{ button_advanced_class }}"
            href="{{ button_link }}"
          >
            <hover-button></hover-button>
            {{- button_text -}}
          </a>
        </div>
      </div>
    {%- endif -%}

    {%- if button_1_text != blank or button_2_text != blank -%}
      <div class="main-buttons {{ text_position_class }}">
        {%- if button_1_text != blank -%}
          <div
            class="main-buttons__item"
            {% if animations_enabled %}
              data-aos="fade-up"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-delay="{{ animation_delay }}"
            {% endif %}
          >
            <a
              class="btn {{ button_1_style }} {{ button_1_size }} {{ button_1_color }} {{ button_1_advanced_class }}"
              href="{{ button_1_link }}"
            >
              <hover-button></hover-button>
              {{- button_1_text | escape -}}
            </a>
          </div>
        {%- endif -%}

        {%- if button_2_text != blank -%}
          <div
            class="main-buttons__item"
            {% if animations_enabled %}
              data-aos="fade-up"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-delay="{{ animation_delay }}"
            {% endif %}
          >
            <a
              class="btn {{ button_2_style }} {{ button_2_size }} {{ button_2_color }} {{ button_2_advanced_class }}"
              href="{{ button_2_link }}"
            >
              <hover-button></hover-button>
              {{- button_2_text | escape -}}
            </a>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- comment -%}
  Renders a testimonial image block

  Uses section/block context when rendered from a section (block).

  Accepts:
  - animation_anchor: {String} Hook for the AOS animation (required)
  - block: {Object} Section block object (required)

  Usage:
  {% render 'testimonial-image' %}
{%- endcomment -%}
{%- liquid
  assign animations_enabled = settings.animations_enabled
  assign block_id = block.id
  assign star_rating = block.settings.star_rating
  assign heading = block.settings.heading
  assign text_size = block.settings.text_size | times: 0.01
  assign customer_name = block.settings.customer_name
  assign percent = star_rating | divided_by: 5.0 | times: 100
  assign image = block.settings.image
  assign aspect_ratio = block.settings.aspect_ratio | times: 100
  assign enable_border = block.settings.enable_border
  assign block_color = block.settings.block_color
  assign image_alt = image.alt | escape

  assign inner_item_animation = false
  if animations_enabled and enable_border == false
    assign inner_item_animation = true
  endif

  comment
    Images sizes
  endcomment
  assign blocks_count = section.blocks.size
  assign blocks_gaps = blocks_count | minus: 1
  assign gaps_calc = 20 | times: blocks_gaps | append: 'px'

  # Desktop widths
  if section_width == 'wrapper--full-padded'
    assign wrapper_width_lg = '(100vw - 120px)'
  endif
  if section_width == 'wrapper'
    assign wrapper_width_lg = '(1440px - 120px)'
  endif

  # Desktop widths
  assign img_width_lg = 'calc(' | append: wrapper_width_lg | append: ' - ' | append: gaps_calc | append: ') / ' | append: blocks_count | append: ')'

  # Tablet widths
  assign wrapper_width_md = '(100vw - 2 * 20px)'
  assign img_width_md = 'calc((' | append: wrapper_width_md | append: ' * 0.9 - 20px) / 2)'

  # Mobile widths
  assign img_width_sm = 'calc(' | append: wrapper_width_md | append: ')'
  if blocks_count > 1
    assign img_width_sm = 'calc(' | append: wrapper_width_md | append: ' - 40px)'
  endif

  assign sizes = '(min-width: 1024px) ' | append: img_width_lg | append: ', (min-width: 768px) ' | append: img_width_md | append: ', ' | append: img_width_sm
-%}

<div
  class="testimonial__item testimonial__item__image testimonial__item--{{ block_id }}{% if enable_border %} testimonial__item--border{% endif %}"
  data-item
  data-slide="{{ block.id }}"
  {{ block.shopify_attributes }}
>
  {%- style -%}
    [data-section-id="{{ section.id }}"] .testimonial__item--{{ block_id }} .testimonial__heading { --adjust-body: calc(var(--FONT-ADJUST-BODY) * {{ text_size }}); }
    [data-section-id="{{ section.id }}"] .testimonial__item--{{ block_id }} .testimonial__image__img { --aspect-ratio: {{ aspect_ratio }}%; }

    {%- if block_color.alpha != 0.0 and block_color != '' -%}
      [data-section-id="{{ section.id }}"] .testimonial__item--{{ block_id }}.testimonial__item--border .testimonial__item__inner { background: {{ block_color }}; }
    {%- endif -%}
  {%- endstyle -%}

  <div
    class="testimonial__item__inner"
    {% unless inner_item_animation %}
      data-aos="fade-up"
      data-aos-anchor="{{ animation_anchor }}"
      data-aos-delay="{{ animation_delay }}"
      {%- assign animation_delay = animation_delay | plus: 150 -%}
    {% endunless %}
  >
    <div
      class="testimonial__image"
      {% if inner_item_animation %}
        data-aos="fade-up"
        data-aos-anchor="{{ animation_anchor }}"
        data-aos-delay="{{ animation_delay }}"
        {%- assign animation_delay = animation_delay | plus: 150 -%}
      {% endif %}
    >
      {%- render 'image-fill',
        is_background: true,
        img_object: image,
        sizes: sizes,
        alt: image_alt,
        classes: 'testimonial__image__img'
      -%}
    </div>

    {%- unless heading == blank and customer_name == blank and star_rating == 0 -%}
      <div class="testimonial__item__content">
        {%- unless star_rating == 0 -%}
          <div
            class="testimonial__stars"
            {% if inner_item_animation %}
              data-aos="fade-up"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-delay="{{ animation_delay }}"
              {%- assign animation_delay = animation_delay | plus: 150 -%}
            {% endif %}
          >
            <span class="rating__star" aria-hidden="true" style="--percent: {{ 100 | minus: percent }}%">
              <span class="rating__star__empty">
                {%- for i in (1..5) -%}
                  {%- render 'icon-star-empty' -%}
                {%- endfor -%}
              </span>

              <span class="rating__star__full">
                {%- for i in (1..5) -%}
                  {%- render 'icon-star-full' -%}
                {%- endfor -%}
              </span>
            </span>
          </div>
        {%- endunless -%}

        {%- if heading != blank -%}
          <div
            class="testimonial__heading"
            {% if inner_item_animation %}
              data-aos="fade-up"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-delay="{{ animation_delay }}"
              {%- assign animation_delay = animation_delay | plus: 150 -%}
            {% endif %}
          >
            {{- heading -}}
          </div>
        {%- endif -%}

        {%- if customer_name != blank -%}
          <div
            class="testimonial__user__name"
            {% if inner_item_animation %}
              data-aos="fade-up"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-delay="{{ animation_delay }}"
              {%- assign animation_delay = animation_delay | plus: 150 -%}
            {% endif %}
          >
            {{- customer_name | escape -}}
          </div>
        {%- endif -%}
      </div>
    {%- endunless -%}
  </div>
</div>

{%- comment -%}
  Renders Open Graph and Twitter meta tags

  Accepts:
  - page_image: {Object} Page image for social meta tags (optional)

  Usage:
  {% render 'social-meta-tags' %}
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: shop.url
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  case request.page_type
    when 'product'
      assign page_image = product.featured_image
      assign og_type = 'product'
    when 'article'
      assign page_image = article.image
      assign og_type = 'article'
    when 'collection'
      assign page_image = collection.featured_image
      assign og_type = 'product.group'
    when 'blog'
      assign page_image = blog.image
    when 'page'
      if page.image
        assign page_image = page.image
      endif
    when 'password'
      assign og_url = shop.url
  endcase
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="http:{{ page_image | img_url: 'master' }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | img_url: 'master' }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}"
  >
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

{%- comment -%}
  Renders rich text section content

  Accepts:
  - animation_anchor: {String} Hook for the AOS animation (required)
  - bg_color: {String} Background color CSS value (required)
  - button_2_color: {String} Secondary button color class (required)
  - button_2_link: {String} Secondary button URL (required)
  - button_2_size: {String} Secondary button size class (required)
  - button_2_style: {String} Secondary button style class (required)
  - button_2_text: {String} Secondary button label (required)
  - button_color: {String} Button color class (required)
  - button_link: {String} Button URL (required)
  - button_size: {String} Button size class (required)
  - button_style: {String} Button style class (required)
  - button_text: {String} Button label (required)
  - heading: {String} Section heading (required)
  - section_width: {String} Section width setting (required)
  - subheading: {String} Section subheading (required)
  - text: {String} Body text content (required)
  - text_position: {String} Text position setting (required)
  - top_image: {Object} Top image for rich text (required)

  Usage:
  {% render 'rich-text' %}
{%- endcomment -%}
{%- style -%}
  #BrickBlock--{{ block_id }} .rich-text__heading { --adjust-heading: calc(var(--FONT-ADJUST-HEADING) * {{ heading_size }}) }
  #BrickBlock--{{ block_id }} .rich-text__text { --adjust-body: calc(var(--FONT-ADJUST-BODY) * {{ text_size }}) }

  {%- if text_color.alpha != 0.0 and text_color != '' -%}
    #BrickBlock--{{ block_id }} .rich-text,
    #BrickBlock--{{ block_id }} .rich-text__heading {
        color: {{ text_color }};
    }
  {%- endif -%}
{%- endstyle -%}

{%- liquid
  assign animations_enabled = settings.animations_enabled
  assign animation_delay = 150

  assign button_advanced_class = 'btn--advanced'
  if button_style != 'btn--text'
    assign button_advanced_class = button_advanced_class | append: ' btn--advanced-width-height'
  endif
  assign button_2_advanced_class = 'btn--advanced'
  if button_2_style != 'btn--text'
    assign button_2_advanced_class = button_2_advanced_class | append: ' btn--advanced-width-height'
  endif

  case text_position
    when 'left'
      assign text_position_class = 'text-left text-left--mobile'
    when 'center'
      assign text_position_class = 'text-center text-center--mobile'
    when 'right'
      assign text_position_class = 'text-right text-right--mobile'
  endcase
-%}

{%- capture content -%}
  {%- if top_image != blank -%}
    <div class="rich-text__top-image"
      {% if animations_enabled %}
        data-aos="fade-up"
        data-aos-anchor="{{ animation_anchor }}"
        data-aos-delay="{{ animation_delay }}"
      {% endif %}>
      {%- liquid
        assign animation_delay = animation_delay | plus: 150
        assign image_alt = top_image.alt | escape
        assign retina_size = top_image_width | times: 2
        assign image_widths = top_image_width | append: ', ' | append: retina_size
        assign sizes = 'min((100vw - 60px - 40px), ' | append: top_image_width | append: 'px' | append: ')'

        capture styles
          echo 'width: ' | append: top_image_width | append: 'px;'
        endcapture
      -%}

      {%- render 'image',
        image: top_image,
        widths: image_widths,
        sizes: sizes,
        alt: image_alt,
        classes: 'rich-text__top-image-img',
        cover: false,
        styles: styles -%}
    </div>
  {%- endif -%}

  {%- if subheading != blank -%}
    <div class="subheading-text main-subheading"
      {% if animations_enabled %}
        data-aos="fade-up"
        data-aos-anchor="{{ animation_anchor }}"
        data-aos-delay="{{ animation_delay }}"
        {%- assign animation_delay = animation_delay | plus: 150 -%}
      {% endif %}>{{ subheading }}</div>
  {%- endif -%}

  {%- if heading != blank -%}
    <h3 class="rich-text__heading h2"
      {% if animations_enabled %}
        data-aos="fade-up"
        data-aos-anchor="{{ animation_anchor }}"
        data-aos-delay="{{ animation_delay }}"
        {%- assign animation_delay = animation_delay | plus: 150 -%}
      {% endif %}>{{ heading }}</h3>

    {%- if settings.show_spacer_lines -%}
      <hr
        {% if animations_enabled %}
          data-aos="fade-up"
          data-aos-delay="{{ animation_delay }}"
          data-aos-anchor="{{ animation_anchor }}"
        {% endif %}>
      {%- assign animation_delay = animation_delay | plus: 150 -%}
    {%- endif -%}
  {%- endif -%}

  {%- if text != blank -%}
    <div class="rich-text__text"
      {% if animations_enabled %}
        data-aos="fade-up"
        data-aos-anchor="{{ animation_anchor }}"
        data-aos-delay="{{ animation_delay }}"
        {%- assign animation_delay = animation_delay | plus: 150 -%}
      {% endif %}>{{ text }}</div>
  {%- endif -%}

  {%- if button_text != blank or button_2_text != blank -%}
    <div class="rich-text__buttons main-buttons">
      {%- if button_text != blank -%}
        <div class="main-buttons__item"
          {% if animations_enabled %}
            data-aos="fade-up"
            data-aos-anchor="{{ animation_anchor }}"
            data-aos-delay="{{ animation_delay }}"
            {%- assign animation_delay = animation_delay | plus: 150 -%}
          {% endif %}>
          <a class="btn {{ button_style }} {{ button_size }} {{ button_color }} {{ button_advanced_class }}" href="{{ button_link }}">
            <hover-button></hover-button>
            {{- button_text -}}
          </a>
        </div>
      {%- endif -%}

      {%- if button_2_text != blank -%}
        <div class="main-buttons__item"
          {% if animations_enabled %}
            data-aos="fade-up"
            data-aos-anchor="{{ animation_anchor }}"
            data-aos-delay="{{ animation_delay }}"
            {%- assign animation_delay = animation_delay | plus: 150 -%}
          {% endif %}>
          <a class="btn {{ button_2_style }} {{ button_2_size }} {{ button_2_color }} {{ button_2_advanced_class }}" href="{{ button_2_link }}">
            <hover-button></hover-button>
            {{- button_2_text -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<div class="rich-text {{ text_position_class }}{%- render 'button-fallback-classes', primary_color: button_color, secondary_color: button_2_color, section_bg_color: bg_color -%}">
  <div class="{{ section_width }}">
    <div class="rich-text__container">
      {{- content -}}
    </div>
  </div>
</div>
